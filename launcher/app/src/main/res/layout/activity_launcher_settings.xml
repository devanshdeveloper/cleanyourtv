<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/settingsRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <!-- Wallpaper behind settings when theme defines one -->
    <ImageView
        android:id="@+id/settingsWallpaper"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:importantForAccessibility="no"
        android:visibility="gone" />

    <!-- Top-Level Category Navigation View -->
    <ScrollView
        android:id="@+id/categoriesScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="72dp"
            android:paddingEnd="72dp"
            android:paddingTop="38dp"
            android:paddingBottom="48dp">

            <TextView
                android:id="@+id/mainTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/launcher_settings"
                android:textColor="@drawable/pill_text"
                android:textSize="34sp"
                android:fontFamily="@string/font_medium" />

            <TextView
                android:id="@+id/mainSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/launcher_settings_help"
                android:textColor="@drawable/pill_text_dim"
                android:textSize="15sp"
                android:fontFamily="@string/font_body" />

            <TextView
                android:id="@+id/reorderChoice"
                style="@style/SettingsRow"
                android:layout_marginTop="28dp"
                android:text="@string/reorder"
                android:visibility="gone" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="@string/columns_label"
                android:textColor="@drawable/pill_text"
                android:textSize="20sp"
                android:fontFamily="@string/font_medium"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal"
                android:visibility="gone">

                <TextView android:id="@+id/columns4" style="@style/SettingsColumnChoice" android:text="4" />
                <TextView android:id="@+id/columns5" style="@style/SettingsColumnChoice" android:text="5" />
                <TextView android:id="@+id/columns6" style="@style/SettingsColumnChoice" android:text="6" />
                <TextView android:id="@+id/columns7" style="@style/SettingsColumnChoice" android:text="7" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="@string/rows_below_dock_label"
                android:textColor="@drawable/pill_text"
                android:textSize="20sp"
                android:fontFamily="@string/font_medium"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal"
                android:visibility="gone">

                <TextView android:id="@+id/rows0" style="@style/SettingsColumnChoice" android:text="0" />
                <TextView android:id="@+id/rows1" style="@style/SettingsColumnChoice" android:text="1" />
                <TextView android:id="@+id/rows2" style="@style/SettingsColumnChoice" android:text="2" />
                <TextView android:id="@+id/rows3" style="@style/SettingsColumnChoice" android:text="3" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="@string/dock_opacity_label"
                android:textColor="@drawable/pill_text"
                android:textSize="20sp"
                android:fontFamily="@string/font_medium"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal"
                android:visibility="gone">

                <TextView android:id="@+id/dock100" style="@style/SettingsColumnChoice" android:text="100%" />
                <TextView android:id="@+id/dock70" style="@style/SettingsColumnChoice" android:text="70%" />
                <TextView android:id="@+id/dock50" style="@style/SettingsColumnChoice" android:text="50%" />
                <TextView android:id="@+id/dock30" style="@style/SettingsColumnChoice" android:text="30%" />
            </LinearLayout>

            <TextView
                android:id="@+id/wallpaperChoice"
                style="@style/SettingsRow"
                android:layout_marginTop="28dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/animationsChoice"
                style="@style/SettingsRow"
                android:layout_marginTop="28dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/advancedChoice"
                style="@style/SettingsRow"
                android:layout_marginTop="10dp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/categoriesContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/followThemeChoice"
                style="@style/SettingsRow"
                android:layout_marginTop="24dp"
                android:text="@string/follow_theme" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/follow_theme_hint"
                android:textColor="@drawable/pill_text_dim"
                android:textSize="13sp"
                android:fontFamily="@string/font_body" />

            <TextView
                android:id="@+id/defaultHomeChoice"
                style="@style/SettingsRow"
                android:layout_marginTop="14dp"
                android:text="@string/home_settings" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/home_settings_help"
                android:textColor="@drawable/pill_text_dim"
                android:textSize="13sp"
                android:fontFamily="@string/font_body" />

            <TextView
                android:id="@+id/tvSettingsChoice"
                style="@style/SettingsRow"
                android:layout_marginTop="14dp"
                android:text="@string/tv_settings" />
        </LinearLayout>
    </ScrollView>

    <!-- Category Detail Sub-Page View -->
    <ScrollView
        android:id="@+id/subpageScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="72dp"
            android:paddingEnd="72dp"
            android:paddingTop="38dp"
            android:paddingBottom="48dp">

            <TextView
                android:id="@+id/subpageBack"
                style="@style/TopButtonBase"
                android:layout_width="wrap_content"
                android:paddingStart="18dp"
                android:paddingEnd="22dp"
                android:text="@string/back_to_categories" />

            <TextView
                android:id="@+id/subpageTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:textColor="@drawable/pill_text"
                android:textSize="32sp"
                android:fontFamily="@string/font_medium" />

            <TextView
                android:id="@+id/subpageSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@drawable/pill_text_dim"
                android:textSize="15sp"
                android:fontFamily="@string/font_body" />

            <LinearLayout
                android:id="@+id/subpageItemsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/subpageReset"
                style="@style/TopButtonBase"
                android:layout_marginTop="24dp"
                android:text="@string/reset_category_defaults" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>

