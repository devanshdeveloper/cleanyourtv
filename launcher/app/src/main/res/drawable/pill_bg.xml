<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/theme_seed_f5ffffff" />
            <corners android:radius="@dimen/theme_seed_radius_21" />
        </shape>
    </item>
    <!-- Reorder button while reorder mode is on (focus is on the tiles then). -->
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/theme_seed_596ec1ff" />
            <stroke android:width="1.5dp" android:color="@color/theme_seed_ff6ec1ff" />
            <corners android:radius="@dimen/theme_seed_radius_21" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="@color/theme_seed_2effffff" android:endColor="@color/theme_seed_14ffffff" />
            <stroke android:width="1dp" android:color="@color/theme_seed_38ffffff" />
            <corners android:radius="@dimen/theme_seed_radius_21" />
        </shape>
    </item>
</selector>
